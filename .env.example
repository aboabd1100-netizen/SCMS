SCMS_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://scms:replace-password@127.0.0.1:54329/scms
RATELIMIT_STORAGE_URI=memory://
# Production requires HTTPS, secure cookies, allowed hosts and shared rate limits.
# SCMS_ENV=production
# TRUSTED_HOSTS=scms.example.com
# Railway health probes also require healthcheck.railway.app in TRUSTED_HOSTS.
# PROXY_HOPS=1  # Only behind a trusted ingress with one proxy; direct local access uses 0.
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# Optional password recovery; no email is sent until configured.
# PUBLIC_BASE_URL=https://scms.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# MAIL_FROM=support@scms.example.com
